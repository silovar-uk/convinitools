{
  "manifest_version": 3,
  "name": "テキスト便利変換ツール (Side Panel)",
  "version": "2.0.0",
  "description": "改行修正、レッズ検索、縦方向の時間選択と条件カード編集に対応した調整カレンダーなどの便利ツール集（サイドパネル版）",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "clipboardWrite",
    "contextMenus",
    "storage",
    "sidePanel"
  ],
  "action": {
    "default_title": "サイドパネルを開く"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
