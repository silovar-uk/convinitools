{
  "manifest_version": 3,
  "name": "テキスト便利変換ツール (Side Panel)",
  "version": "2.2.0",
  "description": "定型メール作成、改行修正、全半角変換、調整カレンダー、Markdown変換などをまとめた便利ツール集（サイドパネル版）",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "clipboardWrite",
    "contextMenus",
    "storage",
    "sidePanel"
  ],
  "action": {
    "default_title": "サイドパネルを開く"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "minimum_chrome_version": "116"
}
